{
  "opencollection": "1.0.0",
  "info": {
    "name": "INRIX Analytics Webservice Template API"
  },
  "items": [
    {
      "info": {
        "name": "Default",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "intersectionAvailability",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/metrics/intersections/availability",
            "params": [
              {
                "name": "startDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "intersectionOutputMode",
                "value": "",
                "type": "query"
              },
              {
                "name": "namespaces",
                "value": "",
                "type": "query"
              },
              {
                "name": "travelTimeType",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        },
        {
          "info": {
            "name": "intersectionMetadata",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/metadata/intersections",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        },
        {
          "info": {
            "name": "intersectionMetrics",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/metrics/intersections",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        }
      ]
    },
    {
      "info": {
        "name": "Namespace Management",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Update namespace",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/v1/namespace/:namespace",
            "params": [
              {
                "name": "namespace",
                "value": "",
                "type": "path",
                "description": "Namespace identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update intersection subscription status for a specific namespace"
        },
        {
          "info": {
            "name": "Delete namespace",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v1/namespace/:namespace",
            "params": [
              {
                "name": "namespace",
                "value": "",
                "type": "path",
                "description": "Namespace identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a namespace and all its intersection subscription data"
        },
        {
          "info": {
            "name": "Search namespaces",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/namespace/search",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Search for intersection subscription status across multiple namespaces"
        }
      ]
    }
  ],
  "bundled": true
}